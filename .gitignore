# Build output (regenerate with build.bat). Anchored to the repo root with "/" so they don't
# also match JUCE/extras/Build, which JUCE needs (Windows paths are case-insensitive).
/build/
/build-*/
/out/

# Editor / OS clutter
.vs/
.vscode/
*.user
Thumbs.db
desktop.ini

# Stray copy of the empty starter repo
/Decoherence/
